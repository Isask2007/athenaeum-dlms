# --- Server ---
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES=7d

# --- Database: sqlite (zero config) | mysql ---
DB_DRIVER=sqlite
SQLITE_FILE=server/data/dlms.sqlite

# MySQL (used when DB_DRIVER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dlms

# --- Uploads ---
MAX_UPLOAD_MB=20
